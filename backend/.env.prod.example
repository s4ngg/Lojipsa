# 프로덕션(EC2) 전용 환경변수. backend/.env.prod로 복사해서 채운 뒤,
# deploy/docker-compose.prod.yml이 이 파일을 읽습니다. .env.prod는 git에 커밋하지 않습니다.

# --- 로컬 개발용 .env와 값이 같아도 되는 것들 ---
SLACK_BOT_TOKEN=xoxb-여기에-본인-토큰
SLACK_CHANNEL=#로아-숙제-알림
LOSTARK_API_KEY=여기에-본인-JWT
ADMIN_TOKEN=여기에-본인이-정한-비밀번호
ANTHROPIC_API_KEY=여기에-본인-API-키
DISCORD_CLIENT_ID=여기에-본인-클라이언트ID
DISCORD_CLIENT_SECRET=여기에-본인-클라이언트시크릿
JWT_SECRET=여기에-충분히-긴-임의의-문자열

# --- 프로덕션에서만 새로 채우는 것들 ---

# RDS PostgreSQL 엔드포인트 (RDS 콘솔에서 확인)
DB_URL=jdbc:postgresql://여기에-RDS-엔드포인트:5432/lojipsa
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=lojipsa
DB_PASSWORD=여기에-RDS-마스터-비밀번호

# 프론트엔드가 실제로 올라간 도메인들 (콤마로 여러 개 가능)
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://admin.YOUR_DOMAIN

# Discord 개발자 포털의 Redirect URI도 이 값과 정확히 일치해야 함
DISCORD_REDIRECT_URI=https://api.YOUR_DOMAIN/api/auth/discord/callback
DISCORD_FRONTEND_REDIRECT_URL=https://YOUR_DOMAIN/my
